# OpenSky Network API Credentials
OPENSKY_USERNAME=your_username_here
OPENSKY_PASSWORD=your_password_here

# Home Coordinates (Manhattan, NYC)
HOME_LATITUDE=40.7717582
HOME_LONGITUDE=-73.9885713

# Bounding Box for NYC Area
BBOX_LAT_MIN=40.7
BBOX_LAT_MAX=40.9
BBOX_LON_MIN=-74.1
BBOX_LON_MAX=-73.8

# View Filter (Northeast direction)
BEARING_MIN=30
BEARING_MAX=120

# Refresh Interval (seconds)
REFRESH_INTERVAL=10
